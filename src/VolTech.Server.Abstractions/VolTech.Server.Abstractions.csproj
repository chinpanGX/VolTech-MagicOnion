<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Unity と共有するので netstandard2.1 / C# 9 に合わせる(Unity 7.0 のアルファ版の上限) -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>VolTech.Server.Abstractions</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 公開 API の XML コメントは書くが、全メンバーは強制しない -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- ソースの実体は Unity パッケージにあるので、このフォルダーの .cs は拾わない -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Unity/com.chinpangx.voltech.magiconion/Runtime/Abstractions/**/*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MagicOnion.Abstractions" />
    <PackageReference Include="MessagePack.Annotations" />
  </ItemGroup>

</Project>
